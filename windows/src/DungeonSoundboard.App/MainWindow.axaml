<Window
    x:Class="DungeonSoundboard.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dungeon Soundboard"
    Width="1220"
    Height="780"
    MinWidth="1040"
    MinHeight="680"
    Background="{Binding BackgroundBrush}"
    KeyDown="OnKeyDown">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="Button.tileAction">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{Binding AccentBrush}" />
      <Setter Property="Foreground" Value="#11151B" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{Binding DangerBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="TextBox.deckName">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.trackTile">
      <Setter Property="Background" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.trackTile">
      <Setter Property="Background" Value="{Binding DataContext.CurrentCardBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="Border.trackTile">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinHeight" Value="54" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Border.emptyState">
      <Setter Property="Background" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="TextBlock.emptyTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid Margin="14" RowDefinitions="Auto,*,Auto">
    <Border Grid.RowSpan="3" Margin="-14" Background="{Binding BackgroundOverlayBrush}" IsHitTestVisible="False" />

    <Border Grid.Row="0" Background="{Binding PanelAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="Dungeon Soundboard" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="{Binding CaptureStatus}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
          <TextBlock Classes="caption" Text="Theme" VerticalAlignment="Center" />
          <ComboBox Width="178" ItemsSource="{Binding ThemePresetOptions}" SelectedItem="{Binding SelectedThemePreset}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <Button Grid.Column="2" Content="Settings" Click="OnSettingsClick" VerticalAlignment="Center" />
        <Button Grid.Column="3" Content="Background" Command="{Binding ChooseBackgroundImageCommand}" VerticalAlignment="Center" />
        <Border Grid.Column="4" Classes="badge" Width="260" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="{Binding StatusMessage}" Classes="caption" Foreground="{Binding StatusMessageBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="292,10,*" DragDrop.AllowDrop="True">
      <Border Grid.Column="0" Background="{Binding PanelBrush}" CornerRadius="8" Padding="12">
        <Grid RowDefinitions="Auto,*,10,Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Music Playlists" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="Choose the playlist used by the music deck" />
            </StackPanel>
            <Button Grid.Column="1" Classes="compact primary" Content="+" Command="{Binding CreateMusicPlaylistCommand}" />
            <Button Grid.Column="2" Classes="compact danger" Content="-" Command="{Binding DeleteMusicPlaylistCommand}" />
            <Button Grid.Column="3" Classes="compact" Content="Up" Command="{Binding MoveMusicPlaylistUpCommand}" />
            <Button Grid.Column="4" Classes="compact" Content="Down" Command="{Binding MoveMusicPlaylistDownCommand}" />
          </Grid>

          <ListBox Grid.Row="1" ItemsSource="{Binding MusicPlaylists}" SelectedItem="{Binding SelectedMusicPlaylist}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{Binding DataContext.CardBrush, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="6" Padding="10,8" Margin="0,2">
                  <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding}">
                      <MenuItem
                          Header="Shuffle Play"
                          Command="{Binding DataContext.PlayMusicPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                      <Separator />
                      <MenuItem
                          Header="Move Up"
                          Command="{Binding DataContext.MoveMusicPlaylistItemUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                      <MenuItem
                          Header="Move Down"
                          Command="{Binding DataContext.MoveMusicPlaylistItemDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                      <Separator />
                      <MenuItem
                          Header="Delete"
                          Command="{Binding DataContext.DeleteMusicPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        Classes="compact"
                        Content="Shuffle"
                        Command="{Binding DataContext.PlayMusicPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Tracks.Count}" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,8,0,8">
            <StackPanel>
              <TextBlock Text="SFX Playlists" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="Concurrent effects and stingers" />
            </StackPanel>
            <Button Grid.Column="1" Classes="compact primary" Content="+" Command="{Binding CreateEffectPlaylistCommand}" />
            <Button Grid.Column="2" Classes="compact danger" Content="-" Command="{Binding DeleteEffectPlaylistCommand}" />
            <Button Grid.Column="3" Classes="compact" Content="Up" Command="{Binding MoveEffectPlaylistUpCommand}" />
            <Button Grid.Column="4" Classes="compact" Content="Down" Command="{Binding MoveEffectPlaylistDownCommand}" />
          </Grid>

          <ListBox Grid.Row="4" ItemsSource="{Binding EffectPlaylists}" SelectedItem="{Binding SelectedEffectPlaylist}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{Binding DataContext.CardBrush, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="6" Padding="10,8" Margin="0,2">
                  <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding}">
                      <MenuItem
                          Header="Move Up"
                          Command="{Binding DataContext.MoveEffectPlaylistItemUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                      <MenuItem
                          Header="Move Down"
                          Command="{Binding DataContext.MoveEffectPlaylistItemDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                      <Separator />
                      <MenuItem
                          Header="Delete"
                          Command="{Binding DataContext.DeleteEffectPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Effects.Count}" Margin="10,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{Binding AccentBrush}" Opacity="0.42" />

      <Grid Grid.Column="2" RowDefinitions="*,10,*">
        <Border Grid.Row="0" Background="{Binding PanelBrush}" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.DragOver="OnMusicDragOver" DragDrop.Drop="OnMusicDrop">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Classes="deckName" Text="{Binding SelectedMusicPlaylistName}" PlaceholderText="Music playlist name" />
                  <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Classes="caption" Text="{Binding MusicTrackCountText}" />
                  </Border>
                </Grid>
                <TextBlock Classes="caption" Text="Music deck" Margin="2,2,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="Add Files" Command="{Binding AddMusicFilesCommand}" />
              <Button Grid.Column="2" Content="Add Folder" Command="{Binding AddMusicFolderCommand}" />
              <Button Grid.Column="3" Classes="primary" Content="Play" Command="{Binding PlaySelectedMusicCommand}" />
              <Button Grid.Column="4" Classes="danger" Content="Delete" Command="{Binding DeleteMusicTrackCommand}" />
            </Grid>

            <ListBox Grid.Row="1"
                     IsVisible="{Binding HasMusicTracks}"
                     ItemsSource="{Binding MusicTrackTiles}"
                     SelectedItem="{Binding SelectedMusicTrackTile}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel
                      ItemWidth="{Binding DataContext.MusicTileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      ItemSpacing="8"
                      LineSpacing="8" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trackTile" Width="{Binding DataContext.MusicTileWidth, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding DataContext.CardBrush, RelativeSource={RelativeSource AncestorType=Window}}" Cursor="Hand" Tapped="OnMusicTrackTapped">
                    <Border.ContextMenu>
                      <ContextMenu DataContext="{Binding}">
                        <MenuItem Header="Play" Tag="{Binding Track}" Click="OnPlayMusicTrackMenuClick" />
                        <MenuItem Header="Bind Hotkey" Tag="{Binding Track}" Click="OnBindMusicTrackMenuClick" />
                        <MenuItem Header="Clear Hotkey" Tag="{Binding Track}" Click="OnClearMusicTrackHotkeyMenuClick" />
                        <Separator />
                        <MenuItem Header="Move Up" Tag="{Binding Track}" Click="OnMoveMusicTrackUpMenuClick" />
                        <MenuItem Header="Move Down" Tag="{Binding Track}" Click="OnMoveMusicTrackDownMenuClick" />
                        <Separator />
                        <MenuItem Header="Delete" Tag="{Binding Track}" Click="OnDeleteMusicTrackMenuClick" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="4,*" ColumnSpacing="8">
                      <Border Width="4" CornerRadius="2" Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" IsVisible="{Binding IsCurrent}" />
                      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,0">
                            <Border Classes="badge" IsVisible="{Binding IsCurrent}">
                              <TextBlock Classes="caption" Text="Playing" Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Border>
                            <Border Classes="badge" IsVisible="{Binding HasHotkey}">
                              <TextBlock Classes="caption" FontFamily="Consolas" Text="{Binding HotkeyText}" />
                            </Border>
                            <Border Classes="badge" IsVisible="{Binding IsFileMissing}">
                              <TextBlock Classes="caption" Text="Missing" Foreground="{Binding DataContext.DangerBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Border>
                            <Border Classes="badge">
                              <TextBlock Classes="caption" Text="{Binding VolumeMultiplier, StringFormat={}{0:P0}}" />
                            </Border>
                          </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Classes="caption" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                          <Button Classes="tileAction primary"
                                  Content="Play"
                                  ToolTip.Tip="Play this music track"
                                  Command="{Binding DataContext.PlayMusicTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Track}" />
                          <Button Classes="tileAction"
                                  Content="Key"
                                  ToolTip.Tip="Assign a local hotkey to this track"
                                  Command="{Binding DataContext.BindMusicTrackItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Track}" />
                          <Button Classes="tileAction danger"
                                  Content="Del"
                                  ToolTip.Tip="Delete this track from the playlist"
                                  Command="{Binding DataContext.DeleteMusicTrackItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Track}" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Classes="emptyState" IsVisible="{Binding IsMusicTracksEmpty}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                <TextBlock Classes="emptyTitle" Text="No music tracks" />
                <TextBlock Classes="caption" Text="Music playlist is empty" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                  <Button Classes="primary" Content="Add Files" Command="{Binding AddMusicFilesCommand}" />
                  <Button Content="Add Folder" Command="{Binding AddMusicFolderCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{Binding PanelAltBrush}" CornerRadius="7" Padding="8" Margin="0,10,0,0">
              <Grid ColumnDefinitions="*,150,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                <TextBox Text="{Binding SelectedMusicTrackTitle}" PlaceholderText="Selected track title" />
                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding SelectedMusicTrackVolume}" VerticalAlignment="Center" Margin="8,0" />
                <Button Grid.Column="2" Content="Bind" Command="{Binding BindSelectedMusicCommand}" />
                <Button Grid.Column="3" Content="Clear" Command="{Binding ClearSelectedMusicBindingCommand}" />
                <Button Grid.Column="4" Classes="compact" Content="Up" Command="{Binding MoveMusicTrackUpCommand}" />
                <Button Grid.Column="5" Classes="compact" Content="Down" Command="{Binding MoveMusicTrackDownCommand}" />
                <Button Grid.Column="6" Content="Cancel Bind" Command="{Binding CancelHotkeyCaptureCommand}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="7" Classes="caption" Text="{Binding SelectedMusicTrackFileStatus}" Margin="4,4,0,0" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{Binding AccentBrush}" Opacity="0.42" />

        <Border Grid.Row="2" Background="{Binding PanelBrush}" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.DragOver="OnEffectDragOver" DragDrop.Drop="OnEffectDrop">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Classes="deckName" Text="{Binding SelectedEffectPlaylistName}" PlaceholderText="SFX playlist name" />
                  <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Classes="caption" Text="{Binding EffectTrackCountText}" />
                  </Border>
                </Grid>
                <TextBlock Classes="caption" Text="SFX deck" Margin="2,2,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="Add Files" Command="{Binding AddEffectFilesCommand}" />
              <Button Grid.Column="2" Content="Add Folder" Command="{Binding AddEffectFolderCommand}" />
              <Button Grid.Column="3" Classes="danger" Content="Delete" Command="{Binding DeleteEffectTrackCommand}" />
            </Grid>

            <ListBox Grid.Row="1"
                     IsVisible="{Binding HasEffectTracks}"
                     ItemsSource="{Binding EffectTrackTiles}"
                     SelectedItem="{Binding SelectedEffectTrackTile}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel
                      ItemWidth="{Binding DataContext.EffectTileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      ItemSpacing="8"
                      LineSpacing="8" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trackTile" Width="{Binding DataContext.EffectTileWidth, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding DataContext.CardBrush, RelativeSource={RelativeSource AncestorType=Window}}" Cursor="Hand" Tapped="OnEffectTrackTapped">
                    <Border.ContextMenu>
                      <ContextMenu DataContext="{Binding}">
                        <MenuItem Header="Play SFX" Tag="{Binding Track}" Click="OnPlayEffectTrackMenuClick" />
                        <MenuItem Header="Bind Hotkey" Tag="{Binding Track}" Click="OnBindEffectTrackMenuClick" />
                        <MenuItem Header="Clear Hotkey" Tag="{Binding Track}" Click="OnClearEffectTrackHotkeyMenuClick" />
                        <Separator />
                        <MenuItem Header="Move Up" Tag="{Binding Track}" Click="OnMoveEffectTrackUpMenuClick" />
                        <MenuItem Header="Move Down" Tag="{Binding Track}" Click="OnMoveEffectTrackDownMenuClick" />
                        <Separator />
                        <MenuItem Header="Delete" Tag="{Binding Track}" Click="OnDeleteEffectTrackMenuClick" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,0">
                          <Border Classes="badge" IsVisible="{Binding HasHotkey}">
                            <TextBlock Classes="caption" FontFamily="Consolas" Text="{Binding HotkeyText}" />
                          </Border>
                          <Border Classes="badge" IsVisible="{Binding IsFileMissing}">
                            <TextBlock Classes="caption" Text="Missing" Foreground="{Binding DataContext.DangerBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                          </Border>
                          <Border Classes="badge">
                            <TextBlock Classes="caption" Text="{Binding VolumeMultiplier, StringFormat={}{0:P0}}" />
                          </Border>
                        </StackPanel>
                      </Grid>
                      <TextBlock Grid.Row="1" Classes="caption" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                        <Button Classes="tileAction primary"
                                Content="Play"
                                ToolTip.Tip="Play this SFX"
                                Command="{Binding DataContext.PlayEffectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Track}" />
                        <Button Classes="tileAction"
                                Content="Key"
                                ToolTip.Tip="Assign a local hotkey to this SFX"
                                Command="{Binding DataContext.BindEffectTrackItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Track}" />
                        <Button Classes="tileAction danger"
                                Content="Del"
                                ToolTip.Tip="Delete this SFX from the playlist"
                                Command="{Binding DataContext.DeleteEffectTrackItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Track}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Classes="emptyState" IsVisible="{Binding IsEffectTracksEmpty}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                <TextBlock Classes="emptyTitle" Text="No SFX tracks" />
                <TextBlock Classes="caption" Text="SFX playlist is empty" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                  <Button Classes="primary" Content="Add Files" Command="{Binding AddEffectFilesCommand}" />
                  <Button Content="Add Folder" Command="{Binding AddEffectFolderCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{Binding PanelAltBrush}" CornerRadius="7" Padding="8" Margin="0,10,0,0">
              <Grid ColumnDefinitions="*,150,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                <TextBox Text="{Binding SelectedEffectTrackTitle}" PlaceholderText="Selected effect title" />
                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding SelectedEffectTrackVolume}" VerticalAlignment="Center" Margin="8,0" />
                <Button Grid.Column="2" Content="Bind" Command="{Binding BindSelectedEffectCommand}" />
                <Button Grid.Column="3" Content="Clear" Command="{Binding ClearSelectedEffectBindingCommand}" />
                <Button Grid.Column="4" Classes="compact" Content="Up" Command="{Binding MoveEffectTrackUpCommand}" />
                <Button Grid.Column="5" Classes="compact" Content="Down" Command="{Binding MoveEffectTrackDownCommand}" />
                <Button Grid.Column="6" Content="Cancel Bind" Command="{Binding CancelHotkeyCaptureCommand}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="7" Classes="caption" Text="{Binding SelectedEffectTrackFileStatus}" Margin="4,4,0,0" />
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{Binding PanelAltBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Button Classes="compact" Content="Prev" Command="{Binding PreviousTrackCommand}" />
          <Button Classes="primary" Width="82" Content="{Binding PlayPauseButtonText}" Command="{Binding PlayPauseCommand}" />
          <Button Classes="compact" Content="Next" Command="{Binding NextTrackCommand}" />
          <Button Content="Stop SFX" Command="{Binding StopEffectsCommand}" />
          <Button Classes="danger" Content="Stop All" Command="{Binding StopAllCommand}" />
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <CheckBox Content="Shuffle" IsChecked="{Binding ShuffleEnabled}" VerticalAlignment="Center" />
          <ComboBox Width="120" ItemsSource="{Binding RepeatModeOptions}" SelectedItem="{Binding RepeatMode}" />
        </StackPanel>

        <StackPanel Grid.Column="6" Width="280" Margin="16,0,0,0">
          <TextBlock Text="{Binding CurrentTrackTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding PlaybackStatus}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Music" VerticalAlignment="Center" Margin="2,8,8,0" />
        <Slider Grid.Row="1" Grid.Column="1" Width="180" Minimum="0" Maximum="1" Value="{Binding MusicVolume}" Margin="0,8,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="SFX" VerticalAlignment="Center" Margin="16,8,8,0" />
        <Slider Grid.Row="1" Grid.Column="3" Width="180" Minimum="0" Maximum="1" Value="{Binding EffectsVolume}" Margin="0,8,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="4" Text="Ducking" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,8,8,0" />
        <Slider Grid.Row="1" Grid.Column="5" Width="190" Minimum="0.2" Maximum="1" Value="{Binding DuckingAmount}" Margin="0,8,0,0" />
        <StackPanel Grid.Row="1" Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,8,0,0">
          <Border Classes="badge" Width="92">
            <TextBlock Classes="caption" Text="{Binding EffectsPlaybackStatus}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Border>
          <Border Classes="badge" Width="96">
            <TextBlock Classes="caption" Text="{Binding DuckingStatus}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.RowSpan="3"
            Background="#AA11151B"
            IsVisible="{Binding IsCapturingHotkey}">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="430"
              MaxWidth="430"
              Padding="22"
              Background="{Binding PanelBrush}"
              BorderBrush="{Binding BorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <StackPanel Spacing="12">
          <TextBlock Text="Assign Hotkey"
                     FontSize="20"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="caption"
                     Text="{Binding CaptureStatus}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Content="Cancel"
                  Command="{Binding CancelHotkeyCaptureCommand}"
                  HorizontalAlignment="Center"
                  Padding="18,8" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
