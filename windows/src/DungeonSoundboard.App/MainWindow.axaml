<Window
    x:Class="DungeonSoundboard.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DungeonSoundboard.App.Controls"
    xmlns:local="using:DungeonSoundboard.App"
    Title="Dungeon Soundboard"
    Icon="/Assets/AppIcon.ico"
    Width="1220"
    Height="780"
    MinWidth="1080"
    MinHeight="680"
    Background="{Binding BackgroundBrush}">
  <Window.Resources>
    <ControlTheme x:Key="SoundboardSliderSegmentTheme" TargetType="RepeatButton">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="SoundboardSliderThumbTheme" TargetType="Thumb">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="SoundboardSliderTheme" TargetType="Slider">
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   Orientation="{TemplateBinding Orientation}"
                   VerticalAlignment="Center">
              <Track.DecreaseButton>
                <RepeatButton Theme="{StaticResource SoundboardSliderSegmentTheme}"
                              Background="{DynamicResource ThemeAccentBrush}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Theme="{StaticResource SoundboardSliderSegmentTheme}"
                              Background="{DynamicResource ThemePanelAltBrush}" />
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb Theme="{StaticResource SoundboardSliderThumbTheme}"
                       Background="{DynamicResource ThemeAccentBrush}"
                       BorderBrush="{DynamicResource ThemePanelBrush}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource ThemePanelTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource ThemePanelTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}" />
      <Setter Property="Background" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{Binding CardBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Button.iconButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.iconButton PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.sidebarAddButton">
      <Setter Property="Width" Value="24" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.sidebarAddButton:pointerover">
      <Setter Property="Background" Value="{Binding PanelAltBrush}" />
    </Style>
    <Style Selector="Button.sidebarAddButton PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{Binding AccentBrush}" />
    </Style>
    <Style Selector="Button.tileIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.tileIcon PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
    </Style>
    <Style Selector="Button.danger.tileIcon">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.danger.tileIcon:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.tileHoverAction">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.tileHoverAction">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected Button.tileHoverAction">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="PathIcon.tileHoverAction">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover PathIcon.tileHoverAction, ListBoxItem:selected PathIcon.tileHoverAction">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="StackPanel.tileActions">
      <Setter Property="Opacity" Value="0.68" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.tileActions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel.tileActions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.playlistAction">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.playlistQuickPlay">
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.playlistAction">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected Button.playlistAction">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover Button.playlistAction">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected Button.playlistQuickPlay">
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover Button.playlistQuickPlay">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="PathIcon.playlistDragHandle">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="PathIcon.playlistDragHandle:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Button.transport">
      <Setter Property="Width" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.stopSfx">
      <Setter Property="Width" Value="28" />
      <Setter Property="MinWidth" Value="28" />
    </Style>
    <Style Selector="Button.transport PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.toolbarAction">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{Binding AccentBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.toolbarAction:pointerover">
      <Setter Property="Background" Value="{Binding PanelAltBrush}" />
    </Style>
    <Style Selector="Button.toolbarAction PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
    </Style>
    <Style Selector="Button.dialogAction">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.dialogAction PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="controls|JumpSlider">
      <Setter Property="Theme" Value="{StaticResource SoundboardSliderTheme}" />
    </Style>
    <Style Selector="Button.playPause PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{Binding AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{Binding DangerBrush}" />
    </Style>
    <Style Selector="Button.danger.dialogAction">
      <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{Binding DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox.deckName">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.brandIconShell">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.brandIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{Binding AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sidebarPanel">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{Binding PanelCornerRadius}" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.centerPanel">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{Binding PanelCornerRadius}" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.deckPanel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="GridSplitter.appSplitter">
      <Setter Property="Background" Value="{Binding PanelAltBrush}" />
      <Setter Property="Opacity" Value="0.46" />
    </Style>
    <Style Selector="GridSplitter.appSplitter:pointerover">
      <Setter Property="Background" Value="{Binding AccentBrush}" />
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="StackPanel.sectionHeaderLine">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.sectionHeaderIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{Binding AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sectionHeaderTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.deckKicker">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:focus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible Border.trackTile">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible Border.playlistRow">
      <Setter Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.trackTile">
      <Setter Property="Background" Value="{DynamicResource ThemePanelAltBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.trackTile TextBlock.trackTitle">
      <Setter Property="Foreground" Value="{DynamicResource ThemePanelAltTextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.trackTile">
      <Setter Property="Background" Value="{DynamicResource ThemeCurrentCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Border.trackTile.trackDropTarget">
      <Setter Property="Background" Value="{DynamicResource ThemeCurrentCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Border.trackTile TextBlock.trackTitle">
      <Setter Property="Foreground" Value="{DynamicResource ThemeCardTextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.trackTile TextBlock.trackTitle">
      <Setter Property="Foreground" Value="{DynamicResource ThemeCurrentCardTextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.playlistRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.playlistName">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.playlistRow">
      <Setter Property="Background" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.playlistName">
      <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.effectPlaylistName">
      <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.playlistRow">
      <Setter Property="Background" Value="{Binding DataContext.CurrentCardBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.effectPlaylistRow">
      <Setter Property="Background" Value="{Binding DataContext.CurrentCardBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="Border.playlistRow.playlistDropTarget">
      <Setter Property="Background" Value="{Binding DataContext.CurrentCardBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="Border.trackTile">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{Binding DataContext.TrackTilePadding, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinHeight" Value="{Binding DataContext.TrackTileMinHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.transportStatus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.transportBar">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{Binding PanelCornerRadius}" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Height" Value="78" />
    </Style>
    <Style Selector="Border.transportCluster">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.transportOptions">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.progressGroup">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.mixerGroup">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="Border.selectedEditor">
      <Setter Property="Background" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderBrush" Value="{Binding DataContext.PanelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="TextBlock.mixerLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="MinWidth" Value="34" />
    </Style>
    <Style Selector="PathIcon.mixerIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.editorLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="MinWidth" Value="46" />
    </Style>
    <Style Selector="TextBlock.tileMetaText">
      <Setter Property="Foreground" Value="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="TextBlock.trackTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="PathIcon.tileMetaIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="18" />
    </Style>
    <Style Selector="Border.statusBadge">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.statusDot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{Binding StatusMessageBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.emptyState">
      <Setter Property="Background" Value="{Binding DataContext.PanelBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderBrush" Value="{Binding DataContext.PanelAltBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinHeight" Value="128" />
    </Style>
    <Style Selector="Border.dropOverlay">
      <Setter Property="Background" Value="{DynamicResource ModalScrimBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{Binding DataContext.PanelCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.modalOverlay">
      <Setter Property="Background" Value="{DynamicResource ModalScrimBrush}" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.modalCard">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{Binding PanelCornerRadius}" />
    </Style>
    <Style Selector="Border.modalCard.danger">
      <Setter Property="BorderBrush" Value="{Binding DangerBrush}" />
    </Style>
    <Style Selector="Border.modalCard.accent">
      <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
    </Style>
    <Style Selector="Border.modalIconShell">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{Binding PanelAltBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="PathIcon.modalIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Foreground" Value="{Binding AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.modalIcon.danger">
      <Setter Property="Foreground" Value="{Binding DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.modalTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.modalMessage">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.modalInput">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border.modalInset">
      <Setter Property="Background" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelAltBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="StackPanel.dialogActions">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.emptyTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid Margin="12" RowDefinitions="48,*,78">
    <Border Grid.RowSpan="3" Margin="-12" Background="{Binding BackgroundOverlayBrush}" IsHitTestVisible="False" />

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="2,0,2,6">
      <TextBlock Text="{Binding Ui.AppTitle}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <Button Grid.Column="2"
              Classes="compact iconButton"
              ToolTip.Tip="{Binding Ui.Settings}"
              AutomationProperties.Name="{Binding Ui.Settings}"
              Command="{Binding OpenSettingsCommand}"
              VerticalAlignment="Center">
        <PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.01L21.54,9.37L19.54,5.9L17.05,6.9C16.52,6.5 15.96,6.18 15.32,5.92L14.94,3.25H10.94L10.56,5.92C9.92,6.18 9.34,6.51 8.83,6.9L6.34,5.9L4.34,9.37L6.46,11.01C6.41,11.33 6.38,11.66 6.38,12C6.38,12.34 6.41,12.66 6.46,12.98L4.34,14.63L6.34,18.1L8.83,17.1C9.35,17.5 9.92,17.82 10.56,18.08L10.94,20.75H14.94L15.32,18.08C15.96,17.82 16.53,17.49 17.05,17.1L19.54,18.1L21.54,14.63L19.43,12.98M12.94,15.5A3.5,3.5 0,1 1 12.94,8.5A3.5,3.5 0,0 1 12.94,15.5Z" />
      </Button>
    </Grid>

    <Grid Grid.Row="1" DragDrop.AllowDrop="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="250" MaxWidth="300" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" MinWidth="560" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Classes="sidebarPanel">
        <Grid x:Name="SidebarSectionsGrid" SizeChanged="OnSectionGridSizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="{Binding SidebarMusicSectionGridLength}" MinHeight="96" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" MinHeight="96" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" RowDefinitions="Auto,*" MinHeight="96">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Classes="sectionHeaderLine">
                <TextBlock Classes="sectionHeaderTitle" Text="{Binding Ui.MusicPlaylists}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="sidebarAddButton" ToolTip.Tip="{Binding Ui.CreateMusicPlaylist}" AutomationProperties.Name="{Binding Ui.CreateMusicPlaylist}" Command="{Binding CreateMusicPlaylistCommand}">
              <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
            </Button>
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding MusicPlaylists}" SelectedItem="{Binding SelectedMusicPlaylist}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="playlistRow"
                        PointerPressed="OnMusicPlaylistPointerPressed"
                        PointerMoved="OnMusicPlaylistPointerMoved"
                        PointerReleased="OnPlaylistPointerReleased"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnMusicPlaylistDragEnter"
                        DragDrop.DragOver="OnMusicPlaylistDragOver"
                        DragDrop.Drop="OnMusicPlaylistDrop">
                  <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding}">
                      <MenuItem Header="{DynamicResource MenuShufflePlayText}" Click="OnPlayMusicPlaylistMenuClick" />
                      <MenuItem Header="{DynamicResource MenuRenameText}" Click="OnRenameMusicPlaylistMenuClick" />
                      <Separator />
                      <MenuItem Header="{DynamicResource MenuDeleteText}" Click="OnDeleteMusicPlaylistMenuClick" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="playlistName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Classes="compact iconButton playlistAction playlistQuickPlay"
                        ToolTip.Tip="{Binding DataContext.Ui.ShufflePlayThisPlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding DataContext.Ui.ShufflePlayThisPlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.PlayMusicPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="0">
                      <PathIcon Data="M10.6,9.2L5.4,4L4,5.4L9.2,10.6L10.6,9.2M14.8,4L16.9,6.1L4,19L5.4,20.4L18.3,7.5L20.4,9.6V4H14.8M14.8,14.8L13.4,16.2L16.8,19.6H14V21.6H21.6V14H19.6V16.8L14.8,14.8Z" />
                    </Button>
                    <PathIcon Grid.Column="2" Classes="playlistDragHandle" Width="14" Height="14" Cursor="SizeAll" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" />
                    <Button
                        Grid.Column="3"
                        Classes="compact iconButton playlistAction"
                        ToolTip.Tip="{Binding DataContext.Ui.Rename, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding DataContext.Ui.Rename, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.RequestRenameMusicPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="0">
                      <PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.01L21.54,9.37L19.54,5.9L17.05,6.9C16.52,6.5 15.96,6.18 15.32,5.92L14.94,3.25H10.94L10.56,5.92C9.92,6.18 9.34,6.51 8.83,6.9L6.34,5.9L4.34,9.37L6.46,11.01C6.41,11.33 6.38,11.66 6.38,12C6.38,12.34 6.41,12.66 6.46,12.98L4.34,14.63L6.34,18.1L8.83,17.1C9.35,17.5 9.92,17.82 10.56,18.08L10.94,20.75H14.94L15.32,18.08C15.96,17.82 16.53,17.49 17.05,17.1L19.54,18.1L21.54,14.63L19.43,12.98M12.94,15.5A3.5,3.5 0,1 1 12.94,8.5A3.5,3.5 0,0 1 12.94,15.5Z" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        Classes="compact danger iconButton playlistAction"
                        ToolTip.Tip="{Binding DataContext.Ui.DeletePlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding DataContext.Ui.DeletePlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.RequestDeleteMusicPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="0">
                      <PathIcon Data="M6,19V7H18V19C18,20.1 17.1,21 16,21H8C6.9,21 6,20.1 6,19M8,9V19H16V9H8M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <GridSplitter Grid.Row="1"
                        Classes="appSplitter"
                        ResizeDirection="Rows"
                        ResizeBehavior="PreviousAndNext"
                        DragCompleted="OnSectionSplitterDragCompleted"
                        MinHeight="10"
                        ToolTip.Tip="{Binding Ui.ResizePlaylistSections}" />

          <Grid Grid.Row="2" RowDefinitions="Auto,*" MinHeight="96">
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,8">
              <StackPanel>
                <StackPanel Classes="sectionHeaderLine">
                  <TextBlock Classes="sectionHeaderTitle" Text="{Binding Ui.SfxPlaylists}" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Classes="sidebarAddButton" ToolTip.Tip="{Binding Ui.CreateSfxPlaylist}" AutomationProperties.Name="{Binding Ui.CreateSfxPlaylist}" Command="{Binding CreateEffectPlaylistCommand}">
                <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
              </Button>
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding EffectPlaylists}" SelectedItem="{Binding SelectedEffectPlaylist}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="playlistRow effectPlaylistRow"
                        PointerPressed="OnEffectPlaylistPointerPressed"
                        PointerMoved="OnEffectPlaylistPointerMoved"
                        PointerReleased="OnPlaylistPointerReleased"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnEffectPlaylistDragEnter"
                        DragDrop.DragOver="OnEffectPlaylistDragOver"
                        DragDrop.Drop="OnEffectPlaylistDrop">
                  <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding}">
                      <MenuItem Header="{DynamicResource MenuShufflePlayText}" Click="OnPlayEffectPlaylistMenuClick" />
                      <MenuItem Header="{DynamicResource MenuRenameText}" Click="OnRenameEffectPlaylistMenuClick" />
                      <Separator />
                      <MenuItem Header="{DynamicResource MenuDeleteText}" Click="OnDeleteEffectPlaylistMenuClick" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="playlistName effectPlaylistName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="compact iconButton playlistAction playlistQuickPlay" ToolTip.Tip="{Binding DataContext.Ui.ShufflePlayThisPlaylist, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding DataContext.Ui.ShufflePlayThisPlaylist, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.PlayEffectPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0"><PathIcon Data="M10.6,9.2L5.4,4L4,5.4L9.2,10.6L10.6,9.2M14.8,4L16.9,6.1L4,19L5.4,20.4L18.3,7.5L20.4,9.6V4H14.8M14.8,14.8L13.4,16.2L16.8,19.6H14V21.6H21.6V14H19.6V16.8L14.8,14.8Z" /></Button>
                    <PathIcon Grid.Column="2" Classes="playlistDragHandle" Width="14" Height="14" Cursor="SizeAll" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" />
                    <Button
                        Grid.Column="3"
                        Classes="compact iconButton playlistAction"
                        ToolTip.Tip="{Binding DataContext.Ui.Rename, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding DataContext.Ui.Rename, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.RequestRenameEffectPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="0">
                      <PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.01L21.54,9.37L19.54,5.9L17.05,6.9C16.52,6.5 15.96,6.18 15.32,5.92L14.94,3.25H10.94L10.56,5.92C9.92,6.18 9.34,6.51 8.83,6.9L6.34,5.9L4.34,9.37L6.46,11.01C6.41,11.33 6.38,11.66 6.38,12C6.38,12.34 6.41,12.66 6.46,12.98L4.34,14.63L6.34,18.1L8.83,17.1C9.35,17.5 9.92,17.82 10.56,18.08L10.94,20.75H14.94L15.32,18.08C15.96,17.82 16.53,17.49 17.05,17.1L19.54,18.1L21.54,14.63L19.43,12.98M12.94,15.5A3.5,3.5 0,1 1 12.94,8.5A3.5,3.5 0,0 1 12.94,15.5Z" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        Classes="compact danger iconButton playlistAction"
                        ToolTip.Tip="{Binding DataContext.Ui.DeletePlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding DataContext.Ui.DeletePlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.RequestDeleteEffectPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="0">
                      <PathIcon Data="M6,19V7H18V19C18,20.1 17.1,21 16,21H8C6.9,21 6,20.1 6,19M8,9V19H16V9H8M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Classes="appSplitter" ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="centerPanel">
      <Grid x:Name="DeckSectionsGrid" SizeChanged="OnSectionGridSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding CenterMusicSectionGridLength}" MinHeight="120" />
          <RowDefinition Height="10" />
          <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Classes="deckPanel" DragDrop.AllowDrop="True" DragDrop.DragEnter="OnMusicDragEnter" DragDrop.DragLeave="OnMusicDragLeave" DragDrop.DragOver="OnMusicDragOver" DragDrop.Drop="OnMusicDrop">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8" ColumnSpacing="8">
              <TextBlock Classes="deckName"
                         Text="{Binding SelectedMusicPlaylistName}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="toolbarAction" Command="{Binding AddMusicFilesCommand}" ToolTip.Tip="{Binding Ui.AddMusicFiles}" AutomationProperties.Name="{Binding Ui.AddMusicFiles}">
                <TextBlock Text="{Binding Ui.AddFiles}" />
              </Button>
              <Button Grid.Column="2" Classes="toolbarAction" Command="{Binding AddMusicFolderCommand}" ToolTip.Tip="{Binding Ui.AddMusicFolder}" AutomationProperties.Name="{Binding Ui.AddMusicFolder}">
                <TextBlock Text="{Binding Ui.AddFolder}" />
              </Button>
              <Button Grid.Column="3" Classes="toolbarAction" IsVisible="{Binding HasMusicTrackDeleteSelection}" ToolTip.Tip="{Binding MusicDeleteSelectionToolTip}" AutomationProperties.Name="{Binding MusicDeleteSelectionToolTip}" Command="{Binding RequestDeleteMusicTrackCommand}">
                <TextBlock Text="{Binding Ui.DeleteSelected}" />
              </Button>
            </Grid>

            <ListBox Grid.Row="1"
                     IsVisible="{Binding HasVisibleMusicTrackTiles}"
                     ItemsSource="{Binding MusicTrackTiles}"
                     SelectedItem="{Binding SelectedMusicTrackTile, Mode=OneWay}"
                     SelectionMode="Multiple"
                     SelectionChanged="OnMusicTrackSelectionChanged"
                     KeyDown="OnMusicTrackListKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding MusicColumns}" VerticalAlignment="Top" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trackTile"
                          Background="{DynamicResource ThemeCardBrush}"
                          ToolTip.Tip="{Binding Path}"
                          Cursor="Hand"
                          Tapped="OnMusicTrackTapped"
                          PointerPressed="OnMusicTrackPointerPressed"
                          PointerMoved="OnMusicTrackPointerMoved"
                          PointerReleased="OnTrackPointerReleased"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragEnter="OnMusicTrackDragEnter"
                          DragDrop.DragOver="OnMusicTrackDragOver"
                          DragDrop.Drop="OnMusicTrackDrop">
                    <Border.ContextMenu>
                      <ContextMenu DataContext="{Binding}">
                        <MenuItem Header="{Binding PlayMenuText}" Tag="{Binding Track}" Click="OnPlayMusicTrackMenuClick" />
                        <MenuItem Header="{Binding RenameMenuText}" Tag="{Binding Track}" Click="OnRenameMusicTrackMenuClick" />
                        <MenuItem Header="{Binding OpenFileLocationMenuText}" Tag="{Binding Track}" Click="OnOpenTrackLocationMenuClick" />
                        <MenuItem StaysOpenOnClick="True">
                          <MenuItem.Header>
                            <Grid Width="220" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                              <TextBlock Text="{Binding VolumeMenuText}" />
                              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding VolumePercentText}" />
                              <controls:JumpSlider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="2" Value="{Binding VolumeMultiplier}" />
                              <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="trackVolumeReset" Command="{Binding ResetVolumeCommand}" Content="{Binding NormalVolumeMenuText}" />
                            </Grid>
                          </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Header="{Binding BindHotkeyMenuText}" Tag="{Binding Track}" Click="OnBindMusicTrackMenuClick" />
                        <MenuItem Header="{Binding ClearHotkeyMenuText}" Tag="{Binding Track}" Click="OnClearMusicTrackHotkeyMenuClick" />
                        <Separator />
                        <MenuItem Header="{Binding DeleteMenuText}" Tag="{Binding Track}" Click="OnDeleteMusicTrackMenuClick" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="4,*,Auto,Auto,Auto,Auto" ColumnSpacing="7">
                      <Border Width="4" CornerRadius="2" Background="{DynamicResource ThemeAccentBrush}" Opacity="0.85" IsVisible="{Binding IsCurrent}" />
                      <TextBlock Grid.Column="1" Classes="trackTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Width="5" Height="5" CornerRadius="3" Background="{DynamicResource ThemeAccentBrush}" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" />
                      <Border Grid.Column="3" Classes="badge" IsVisible="{Binding HasHotkey}" VerticalAlignment="Center">
                        <TextBlock Classes="caption" FontFamily="Consolas" Text="{Binding HotkeyText}" />
                      </Border>
                      <Border Grid.Column="4" Classes="badge" IsVisible="{Binding IsFileMissing}" VerticalAlignment="Center">
                        <TextBlock Classes="caption" Text="{Binding MissingBadgeText}" Foreground="{Binding DataContext.DangerBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </Border>
                      <StackPanel Grid.Column="5" Classes="tileActions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <PathIcon Classes="tileHoverAction" Width="13" Height="13" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" />
                        <Button Classes="tileIcon tileHoverAction"
                                ToolTip.Tip="{Binding DataContext.Ui.Volume, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="{Binding DataContext.Ui.Volume, RelativeSource={RelativeSource AncestorType=Window}}">
                          <PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.01L21.54,9.37L19.54,5.9L17.05,6.9C16.52,6.5 15.96,6.18 15.32,5.92L14.94,3.25H10.94L10.56,5.92C9.92,6.18 9.34,6.51 8.83,6.9L6.34,5.9L4.34,9.37L6.46,11.01C6.41,11.33 6.38,11.66 6.38,12C6.38,12.34 6.41,12.66 6.46,12.98L4.34,14.63L6.34,18.1L8.83,17.1C9.35,17.5 9.92,17.82 10.56,18.08L10.94,20.75H14.94L15.32,18.08C15.96,17.82 16.53,17.49 17.05,17.1L19.54,18.1L21.54,14.63L19.43,12.98M12.94,15.5A3.5,3.5 0,1 1 12.94,8.5A3.5,3.5 0,0 1 12.94,15.5Z" />
                          <Button.Flyout><Flyout Placement="Bottom"><Border Classes="trackVolumePopup" Padding="12" BorderThickness="1" CornerRadius="8"><StackPanel Width="220" Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding VolumeMenuText}" /><TextBlock Grid.Column="1" Classes="caption" Text="{Binding VolumePercentText}" /></Grid><controls:JumpSlider Minimum="0" Maximum="2" Value="{Binding VolumeMultiplier}" /><Button Classes="trackVolumeReset" Command="{Binding ResetVolumeCommand}" Content="{Binding NormalVolumeMenuText}" /></StackPanel></Border></Flyout></Button.Flyout>
                        </Button>
                        <Button Classes="tileIcon danger"
                                ToolTip.Tip="{Binding DataContext.Ui.DeleteThisTrackFromPlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="{Binding DataContext.Ui.DeleteThisTrackFromPlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding DataContext.RequestDeleteMusicTrackItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Track}">
                          <PathIcon Data="M6,19V7H18V19C18,20.1 17.1,21 16,21H8C6.9,21 6,20.1 6,19M8,9V19H16V9H8M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Classes="emptyState" IsVisible="{Binding IsMusicTracksEmpty}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                <PathIcon Width="34"
                          Height="34"
                          Foreground="{Binding AccentBrush}"
                          Data="M12,3V13.55A4,4 0,1 0 14,17V7H20V3H12M10,17A2,2 0,1 1 6,17A2,2 0,0 1 10,17Z" />
                <TextBlock Classes="emptyTitle" Text="{Binding Ui.NoMusicTracks}" />
                <TextBlock Classes="caption"
                           Text="{Binding Ui.NoMusicTracksHint}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="emptyState" IsVisible="{Binding IsMusicSearchEmpty}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                <PathIcon Width="34"
                          Height="34"
                          Foreground="{Binding AccentBrush}"
                          Data="M9.5,3A6.5,6.5 0,0 1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L20.71,20L19.3,21.41L13.03,15.14C11.89,16.03 10.35,16.5 8.75,16.5A6.5,6.5 0,0 1 9.5,3M9.5,5A4.5,4.5 0,1 0 9.5,14A4.5,4.5 0,0 0 9.5,5Z" />
                <TextBlock Classes="emptyTitle" Text="{Binding Ui.NoSearchResults}" />
                <TextBlock Classes="caption"
                           Text="{Binding Ui.NoSearchResultsHint}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Classes="toolbarAction" Command="{Binding ClearMusicSearchCommand}" ToolTip.Tip="{Binding Ui.ClearSearch}" AutomationProperties.Name="{Binding Ui.ClearSearch}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M18.7,6.7L17.3,5.3L12,10.6L6.7,5.3L5.3,6.7L10.6,12L5.3,17.3L6.7,18.7L12,13.4L17.3,18.7L18.7,17.3L13.4,12L18.7,6.7Z" />
                    <TextBlock Text="{Binding Ui.Clear}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border Grid.RowSpan="2" Classes="dropOverlay" BorderBrush="{Binding AccentBrush}" IsVisible="{Binding IsMusicDropTargetActive}" IsHitTestVisible="False">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <PathIcon Width="28" Height="28" Foreground="{Binding AccentBrush}" Data="M5,20H19V18H5V20M19,9H15V3H9V9H5L12,16L19,9Z" />
                <TextBlock Text="{Binding Ui.DropMusicFiles}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="{Binding Ui.DropMusicFilesHint}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Classes="appSplitter" ResizeDirection="Rows" DragCompleted="OnSectionSplitterDragCompleted" />

        <Border Grid.Row="2" Classes="deckPanel" DragDrop.AllowDrop="True" DragDrop.DragEnter="OnEffectDragEnter" DragDrop.DragLeave="OnEffectDragLeave" DragDrop.DragOver="OnEffectDragOver" DragDrop.Drop="OnEffectDrop">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8" ColumnSpacing="8">
              <TextBlock Classes="deckName"
                         Text="{Binding SelectedEffectPlaylistName}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="toolbarAction" Command="{Binding AddEffectFilesCommand}" ToolTip.Tip="{Binding Ui.AddSfxFiles}" AutomationProperties.Name="{Binding Ui.AddSfxFiles}">
                <TextBlock Text="{Binding Ui.AddFiles}" />
              </Button>
              <Button Grid.Column="2" Classes="toolbarAction" Command="{Binding AddEffectFolderCommand}" ToolTip.Tip="{Binding Ui.AddSfxFolder}" AutomationProperties.Name="{Binding Ui.AddSfxFolder}">
                <TextBlock Text="{Binding Ui.AddFolder}" />
              </Button>
              <Button Grid.Column="3" Classes="toolbarAction" IsVisible="{Binding HasEffectTrackDeleteSelection}" ToolTip.Tip="{Binding EffectDeleteSelectionToolTip}" AutomationProperties.Name="{Binding EffectDeleteSelectionToolTip}" Command="{Binding RequestDeleteEffectTrackCommand}">
                <TextBlock Text="{Binding Ui.DeleteSelected}" />
              </Button>
            </Grid>

            <ListBox Grid.Row="1"
                     IsVisible="{Binding HasVisibleEffectTrackTiles}"
                     ItemsSource="{Binding EffectTrackTiles}"
                     SelectedItem="{Binding SelectedEffectTrackTile, Mode=OneWay}"
                     SelectionMode="Multiple"
                     SelectionChanged="OnEffectTrackSelectionChanged"
                     KeyDown="OnEffectTrackListKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding EffectsColumns}" VerticalAlignment="Top" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trackTile"
                          Background="{DynamicResource ThemeCardBrush}"
                          ToolTip.Tip="{Binding Path}"
                          Cursor="Hand"
                          Tapped="OnEffectTrackTapped"
                          PointerPressed="OnEffectTrackPointerPressed"
                          PointerMoved="OnEffectTrackPointerMoved"
                          PointerReleased="OnTrackPointerReleased"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragEnter="OnEffectTrackDragEnter"
                          DragDrop.DragOver="OnEffectTrackDragOver"
                          DragDrop.Drop="OnEffectTrackDrop">
                    <Border.ContextMenu>
                      <ContextMenu DataContext="{Binding}">
                        <MenuItem Header="{Binding PlayMenuText}" Tag="{Binding Track}" Click="OnPlayEffectTrackMenuClick" />
                        <MenuItem Header="{Binding RenameMenuText}" Tag="{Binding Track}" Click="OnRenameEffectTrackMenuClick" />
                        <MenuItem Header="{Binding OpenFileLocationMenuText}" Tag="{Binding Track}" Click="OnOpenTrackLocationMenuClick" />
                        <MenuItem StaysOpenOnClick="True">
                          <MenuItem.Header>
                            <Grid Width="220" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                              <TextBlock Text="{Binding VolumeMenuText}" />
                              <TextBlock Grid.Column="1" Classes="caption" Text="{Binding VolumePercentText}" />
                              <controls:JumpSlider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="2" Value="{Binding VolumeMultiplier}" />
                              <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="trackVolumeReset" Command="{Binding ResetVolumeCommand}" Content="{Binding NormalVolumeMenuText}" />
                            </Grid>
                          </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Header="{Binding BindHotkeyMenuText}" Tag="{Binding Track}" Click="OnBindEffectTrackMenuClick" />
                        <MenuItem Header="{Binding ClearHotkeyMenuText}" Tag="{Binding Track}" Click="OnClearEffectTrackHotkeyMenuClick" />
                        <Separator />
                        <MenuItem Header="{Binding DeleteMenuText}" Tag="{Binding Track}" Click="OnDeleteEffectTrackMenuClick" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                      <TextBlock Classes="trackTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="badge" IsVisible="{Binding HasHotkey}" VerticalAlignment="Center">
                        <TextBlock Classes="caption" FontFamily="Consolas" Text="{Binding HotkeyText}" />
                      </Border>
                      <Border Grid.Column="2" Classes="badge" IsVisible="{Binding IsFileMissing}" VerticalAlignment="Center">
                        <TextBlock Classes="caption" Text="{Binding MissingBadgeText}" Foreground="{Binding DataContext.DangerBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </Border>
                      <StackPanel Grid.Column="3" Classes="tileActions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <PathIcon Classes="tileHoverAction" Width="13" Height="13" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Data="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z" />
                        <Button Classes="tileIcon tileHoverAction"
                                ToolTip.Tip="{Binding DataContext.Ui.Volume, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="{Binding DataContext.Ui.Volume, RelativeSource={RelativeSource AncestorType=Window}}">
                          <PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.01L21.54,9.37L19.54,5.9L17.05,6.9C16.52,6.5 15.96,6.18 15.32,5.92L14.94,3.25H10.94L10.56,5.92C9.92,6.18 9.34,6.51 8.83,6.9L6.34,5.9L4.34,9.37L6.46,11.01C6.41,11.33 6.38,11.66 6.38,12C6.38,12.34 6.41,12.66 6.46,12.98L4.34,14.63L6.34,18.1L8.83,17.1C9.35,17.5 9.92,17.82 10.56,18.08L10.94,20.75H14.94L15.32,18.08C15.96,17.82 16.53,17.49 17.05,17.1L19.54,18.1L21.54,14.63L19.43,12.98M12.94,15.5A3.5,3.5 0,1 1 12.94,8.5A3.5,3.5 0,0 1 12.94,15.5Z" />
                          <Button.Flyout><Flyout Placement="Bottom"><Border Classes="trackVolumePopup" Padding="12" BorderThickness="1" CornerRadius="8"><StackPanel Width="220" Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding VolumeMenuText}" /><TextBlock Grid.Column="1" Classes="caption" Text="{Binding VolumePercentText}" /></Grid><controls:JumpSlider Minimum="0" Maximum="2" Value="{Binding VolumeMultiplier}" /><Button Classes="trackVolumeReset" Command="{Binding ResetVolumeCommand}" Content="{Binding NormalVolumeMenuText}" /></StackPanel></Border></Flyout></Button.Flyout>
                        </Button>
                        <Button Classes="tileIcon danger"
                                ToolTip.Tip="{Binding DataContext.Ui.DeleteThisSfxFromPlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="{Binding DataContext.Ui.DeleteThisSfxFromPlaylist, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding DataContext.RequestDeleteEffectTrackItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Track}">
                          <PathIcon Data="M6,19V7H18V19C18,20.1 17.1,21 16,21H8C6.9,21 6,20.1 6,19M8,9V19H16V9H8M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Classes="emptyState" IsVisible="{Binding IsEffectTracksEmpty}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                <PathIcon Width="34"
                          Height="34"
                          Foreground="{Binding AccentBrush}"
                          Data="M4,12H7L9,4L13,20L15,12H20" />
                <TextBlock Classes="emptyTitle" Text="{Binding Ui.NoSfxTracks}" />
                <TextBlock Classes="caption"
                           Text="{Binding Ui.NoSfxTracksHint}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="emptyState" IsVisible="{Binding IsEffectSearchEmpty}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                <PathIcon Width="34"
                          Height="34"
                          Foreground="{Binding AccentBrush}"
                          Data="M9.5,3A6.5,6.5 0,0 1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L20.71,20L19.3,21.41L13.03,15.14C11.89,16.03 10.35,16.5 8.75,16.5A6.5,6.5 0,0 1 9.5,3M9.5,5A4.5,4.5 0,1 0 9.5,14A4.5,4.5 0,0 0 9.5,5Z" />
                <TextBlock Classes="emptyTitle" Text="{Binding Ui.NoSearchResults}" />
                <TextBlock Classes="caption"
                           Text="{Binding Ui.NoSearchResultsHint}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Classes="toolbarAction" Command="{Binding ClearEffectSearchCommand}" ToolTip.Tip="{Binding Ui.ClearSearch}" AutomationProperties.Name="{Binding Ui.ClearSearch}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M18.7,6.7L17.3,5.3L12,10.6L6.7,5.3L5.3,6.7L10.6,12L5.3,17.3L6.7,18.7L12,13.4L17.3,18.7L18.7,17.3L13.4,12L18.7,6.7Z" />
                    <TextBlock Text="{Binding Ui.Clear}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border Grid.RowSpan="2" Classes="dropOverlay" BorderBrush="{Binding AccentBrush}" IsVisible="{Binding IsEffectDropTargetActive}" IsHitTestVisible="False">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <PathIcon Width="28" Height="28" Foreground="{Binding AccentBrush}" Data="M5,20H19V18H5V20M19,9H15V3H9V9H5L12,16L19,9Z" />
                <TextBlock Text="{Binding Ui.DropSfxFiles}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="{Binding Ui.DropSfxFilesHint}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="transportBar">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="260,112,*,408" ColumnSpacing="10">
        <Border Grid.Row="0" Grid.Column="0" Classes="transportStatus" Width="260" VerticalAlignment="Center">
          <StackPanel Spacing="1">
            <TextBlock Text="{Binding CurrentTrackTitle}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="caption"
                       Text="{Binding CurrentPlaybackPlaylistName}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="transportCluster" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="6">
            <Button Classes="compact transport"
                    ToolTip.Tip="{Binding Ui.PreviousTrack}"
                    AutomationProperties.Name="{Binding Ui.PreviousTrack}"
                    Command="{Binding PreviousTrackCommand}">
              <PathIcon Data="M6,6H8V18H6V6M9,12L18,18V6L9,12Z" />
            </Button>
            <Button Classes="primary playPause"
                    Width="34"
                    MinWidth="34"
                    Height="28"
                    MinHeight="28"
                    ToolTip.Tip="{Binding PlayPauseButtonText}"
                    AutomationProperties.Name="{Binding PlayPauseButtonText}"
                    Command="{Binding PlayPauseCommand}">
              <PathIcon Data="{Binding PlayPauseIconData}" />
            </Button>
            <Button Classes="compact transport"
                    ToolTip.Tip="{Binding Ui.NextTrack}"
                    AutomationProperties.Name="{Binding Ui.NextTrack}"
                    Command="{Binding NextTrackCommand}">
              <PathIcon Data="M16,18H18V6H16V18M6,18L15,12L6,6V18Z" />
            </Button>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="progressGroup" VerticalAlignment="Center">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <PathIcon Width="13"
                      Height="13"
                      Foreground="{Binding TextSecondaryBrush}"
                      VerticalAlignment="Center"
                      Data="M12,20A8,8 0,1 0 12,4A8,8 0,0 0 12,20M12,6.2A5.8,5.8 0,1 1 12,17.8A5.8,5.8 0,0 1 12,6.2M11,8H13V12.6L16,14.4L15,16L11,13.6V8Z" />
            <controls:JumpSlider Grid.Column="1"
                    MinWidth="220"
                    Minimum="0"
                    Maximum="{Binding PlaybackDurationSeconds}"
                    AutomationProperties.Name="{Binding Ui.NowPlaying}"
                    Value="{Binding PlaybackPositionSeconds}" />
            <TextBlock Grid.Column="2"
                       Classes="caption"
                       Width="92"
                       Text="{Binding PlaybackTimeText}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Classes="transportOptions">
          <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
            <CheckBox Content="{Binding Ui.Shuffle}" IsChecked="{Binding ShuffleEnabled}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Width="156" ItemsSource="{Binding RepeatModeOptions}" SelectedItem="{Binding SelectedRepeatModeOption}" AutomationProperties.Name="{Binding Ui.Playback}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemePanelTextPrimaryBrush}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2"
                    Classes="compact transport stopSfx"
                    Command="{Binding StopEffectsCommand}"
                    ToolTip.Tip="{Binding Ui.StopAllActiveSfx}"
                    AutomationProperties.Name="{Binding Ui.StopAllActiveSfx}">
              <PathIcon Data="M6,6H18V18H6V6Z" />
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="3" ColumnDefinitions="200,200" ColumnSpacing="8" Margin="0,5,0,0" HorizontalAlignment="Right">
          <Border Grid.Column="0" Classes="mixerGroup">
            <Grid ColumnDefinitions="Auto,Auto,90,42" ColumnSpacing="6">
              <PathIcon Classes="mixerIcon" Data="M12,3V13.55A4,4 0,1 0 14,17V7H20V3H12M10,17A2,2 0,1 1 6,17A2,2 0,0 1 10,17Z" />
              <TextBlock Grid.Column="1" Classes="mixerLabel" Text="{Binding Ui.Music}" VerticalAlignment="Center" />
              <controls:JumpSlider Grid.Column="2" Width="90" Minimum="0" Maximum="1" Value="{Binding MusicVolume}" AutomationProperties.Name="{Binding Ui.Music}" />
              <TextBlock Grid.Column="3" Classes="caption" Width="42" Text="{Binding MusicVolumePercentText}" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="mixerGroup">
            <Grid ColumnDefinitions="Auto,Auto,90,42" ColumnSpacing="6">
              <PathIcon Classes="mixerIcon" Data="M4,12H7L9,4L13,20L15,12H20" />
              <TextBlock Grid.Column="1" Classes="mixerLabel" Text="{Binding Ui.Sfx}" VerticalAlignment="Center" />
              <controls:JumpSlider Grid.Column="2" Width="90" Minimum="0" Maximum="1" Value="{Binding EffectsVolume}" AutomationProperties.Name="{Binding Ui.Sfx}" />
              <TextBlock Grid.Column="3" Classes="caption" Width="42" Text="{Binding EffectsVolumePercentText}" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="statusBadge"
            MaxWidth="620"
            Margin="0,54,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsVisible="{Binding HasStatusMessage}"
            ZIndex="20">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
        <Border Classes="statusDot" />
        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <local:SettingsOverlay Grid.RowSpan="3"
                           IsVisible="{Binding IsSettingsVisible}"
                           ZIndex="30" />

    <Border Grid.RowSpan="3"
            Classes="modalOverlay"
            IsVisible="{Binding IsPlaylistRenameVisible}">
      <Border Classes="modalCard"
              Width="440"
              MaxWidth="440">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="modalIconShell">
              <PathIcon Classes="modalIcon" Data="M3,17.25V21H6.75L17.8,9.95L14.05,6.2L3,17.25M20.7,7.05C21.1,6.65 21.1,6 20.7,5.6L18.4,3.3C18,2.9 17.35,2.9 16.95,3.3L15.1,5.15L18.85,8.9L20.7,7.05Z" />
            </Border>
            <TextBlock Grid.Column="1" Classes="modalTitle" Text="{Binding PlaylistRenameTitle}" VerticalAlignment="Center" />
          </Grid>
          <TextBox x:Name="PlaylistRenameTextBox"
                   Classes="modalInput"
                   Text="{Binding PlaylistRenameName}"
                   PlaceholderText="{Binding Ui.PlaylistName}"
                   MinWidth="360" />
          <StackPanel Classes="dialogActions">
            <Button Classes="dialogAction"
                    AutomationProperties.Name="{Binding Ui.Cancel}"
                    Command="{Binding CancelPlaylistRenameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M18.7,6.7L17.3,5.3L12,10.6L6.7,5.3L5.3,6.7L10.6,12L5.3,17.3L6.7,18.7L12,13.4L17.3,18.7L18.7,17.3L13.4,12L18.7,6.7Z" />
                <TextBlock Text="{Binding Ui.Cancel}" />
              </StackPanel>
            </Button>
            <Button Classes="primary dialogAction"
                    AutomationProperties.Name="{Binding Ui.Rename}"
                    Command="{Binding ConfirmPlaylistRenameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M9,16.2L4.8,12L3.4,13.4L9,19L21,7L19.6,5.6L9,16.2Z" />
                <TextBlock Text="{Binding Ui.Rename}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="modalOverlay"
            IsVisible="{Binding IsTrackRenameVisible}">
      <Border Classes="modalCard"
              Width="440"
              MaxWidth="440">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="modalIconShell">
              <PathIcon Classes="modalIcon" Data="M3,17.25V21H6.75L17.8,9.95L14.05,6.2L3,17.25M20.7,7.05C21.1,6.65 21.1,6 20.7,5.6L18.4,3.3C18,2.9 17.35,2.9 16.95,3.3L15.1,5.15L18.85,8.9L20.7,7.05Z" />
            </Border>
            <TextBlock Grid.Column="1" Classes="modalTitle" Text="{Binding TrackRenameTitle}" VerticalAlignment="Center" />
          </Grid>
          <TextBox x:Name="TrackRenameTextBox"
                   Classes="modalInput"
                   Text="{Binding TrackRenameName}"
                   PlaceholderText="{Binding Ui.TrackName}"
                   MinWidth="360" />
          <StackPanel Classes="dialogActions">
            <Button Classes="dialogAction"
                    AutomationProperties.Name="{Binding Ui.Cancel}"
                    Command="{Binding CancelTrackRenameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M18.7,6.7L17.3,5.3L12,10.6L6.7,5.3L5.3,6.7L10.6,12L5.3,17.3L6.7,18.7L12,13.4L17.3,18.7L18.7,17.3L13.4,12L18.7,6.7Z" />
                <TextBlock Text="{Binding Ui.Cancel}" />
              </StackPanel>
            </Button>
            <Button Classes="primary dialogAction"
                    AutomationProperties.Name="{Binding Ui.Rename}"
                    Command="{Binding ConfirmTrackRenameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M9,16.2L4.8,12L3.4,13.4L9,19L21,7L19.6,5.6L9,16.2Z" />
                <TextBlock Text="{Binding Ui.Rename}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="modalOverlay"
            IsVisible="{Binding IsDeleteConfirmationVisible}">
      <Border Classes="modalCard danger"
              Width="500"
              MaxWidth="500">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="modalIconShell">
              <PathIcon Classes="modalIcon danger" Data="M6,19V7H18V19C18,20.1 17.1,21 16,21H8C6.9,21 6,20.1 6,19M8,9V19H16V9H8M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="modalTitle" Text="{Binding DeleteConfirmationTitle}" />
              <TextBlock Classes="modalMessage" Text="{Binding DeleteConfirmationMessage}" />
            </StackPanel>
          </Grid>
          <StackPanel Classes="dialogActions">
            <Button Classes="dialogAction"
                    AutomationProperties.Name="{Binding Ui.Cancel}"
                    Command="{Binding CancelDeleteCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M18.7,6.7L17.3,5.3L12,10.6L6.7,5.3L5.3,6.7L10.6,12L5.3,17.3L6.7,18.7L12,13.4L17.3,18.7L18.7,17.3L13.4,12L18.7,6.7Z" />
                <TextBlock Text="{Binding Ui.Cancel}" />
              </StackPanel>
            </Button>
            <Button Classes="danger dialogAction"
                    AutomationProperties.Name="{Binding Ui.Delete}"
                    Command="{Binding ConfirmDeleteCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M6,19V7H18V19C18,20.1 17.1,21 16,21H8C6.9,21 6,20.1 6,19M8,9V19H16V9H8M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                <TextBlock Text="{Binding Ui.Delete}" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="modalOverlay"
            IsVisible="{Binding IsImportConflictVisible}">
      <Border Classes="modalCard"
              Width="500"
              MaxWidth="500">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="modalIconShell">
              <PathIcon Classes="modalIcon" Data="M5,20H19V18H5V20M19,9H15V3H9V9H5L12,16L19,9Z" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="modalTitle" Text="{Binding ImportConflictTitle}" />
              <TextBlock Classes="modalMessage" Text="{Binding ImportConflictMessage}" />
            </StackPanel>
          </Grid>
          <Border Classes="modalInset">
            <TextBlock Classes="modalMessage"
                       Text="{Binding ImportConflictDuplicateText}"
                       TextWrapping="Wrap" />
          </Border>
          <Button Classes="primary dialogAction"
                  Command="{Binding DismissImportConflictCommand}"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{Binding Ui.Ok}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="M9,16.2L4.8,12L3.4,13.4L9,19L21,7L19.6,5.6L9,16.2Z" />
              <TextBlock Text="{Binding Ui.Ok}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="modalOverlay"
            IsVisible="{Binding IsHotkeyConflictVisible}">
      <Border Classes="modalCard accent"
              Width="500"
              MaxWidth="500">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="modalIconShell">
              <PathIcon Classes="modalIcon" Data="M7,7H17L14,4L15.4,2.6L20.8,8L15.4,13.4L14,12L17,9H7V7M17,17H7L10,20L8.6,21.4L3.2,16L8.6,10.6L10,12L7,15H17V17Z" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="modalTitle" Text="{Binding HotkeyConflictTitle}" />
              <TextBlock Classes="modalMessage" Text="{Binding HotkeyConflictMessage}" />
            </StackPanel>
          </Grid>
          <StackPanel Classes="dialogActions">
            <Button Classes="dialogAction"
                    AutomationProperties.Name="{Binding Ui.Cancel}"
                    Command="{Binding CancelHotkeyConflictCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M18.7,6.7L17.3,5.3L12,10.6L6.7,5.3L5.3,6.7L10.6,12L5.3,17.3L6.7,18.7L12,13.4L17.3,18.7L18.7,17.3L13.4,12L18.7,6.7Z" />
                <TextBlock Text="{Binding Ui.Cancel}" />
              </StackPanel>
            </Button>
            <Button Classes="primary dialogAction"
                    AutomationProperties.Name="{Binding Ui.Replace}"
                    Command="{Binding ConfirmHotkeyConflictCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="M7,7H17L14,4L15.4,2.6L20.8,8L15.4,13.4L14,12L17,9H7V7M17,17H7L10,20L8.6,21.4L3.2,16L8.6,10.6L10,12L7,15H17V17Z" />
                <TextBlock Text="{Binding Ui.Replace}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3"
            Classes="modalOverlay"
            IsVisible="{Binding IsCapturingHotkey}">
      <Border Classes="modalCard"
              Width="440"
              MaxWidth="440">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="modalIconShell">
              <PathIcon Classes="modalIcon" Data="M7,14A4,4 0,1 1 10.7,8H21V11H19V13H16V15H13.7A4,4 0,0 1 7,14M7,16A2,2 0,1 0 7,12A2,2 0,0 0 7,16Z" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="modalTitle" Text="{Binding Ui.AssignHotkeyTitle}" />
              <TextBlock Classes="modalMessage" Text="{Binding CaptureStatus}" />
            </StackPanel>
          </Grid>
          <Button Classes="dialogAction"
                  Command="{Binding CancelHotkeyCaptureCommand}"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{Binding Ui.CancelHotkeyCapture}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="M18.7,6.7L17.3,5.3L12,10.6L6.7,5.3L5.3,6.7L10.6,12L5.3,17.3L6.7,18.7L12,13.4L17.3,18.7L18.7,17.3L13.4,12L18.7,6.7Z" />
              <TextBlock Text="{Binding Ui.Cancel}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
